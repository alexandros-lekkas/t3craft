 "stateRules": {
  "mug": "agent status working -> \"<colour>_steam\"; anything else -> \"<colour>\". One component update per status change; the steam animates itself (8-frame texture).",
  "monitor": "working -> \"on\" (animated diff, light_emission 12); idle / needs_you / done but still assigned -> \"idle\" (T3 wallpaper); desk free -> \"off\".",
  "desk_lamp": "night (dayTime 12600..23400, the same switch as design A lamps) AND the desk has an agent -> \"on\"; otherwise \"off\". Visual only (light_emission on the bulb); the pendants already light the room.",
  "chair": "Normal: yaw = the seat spot yaw. needs_you: swivel the chair (and the seated Mannequin) to face the player: set the ItemDisplay transformation left_rotation to the yaw delta toward the player (rounded to 15deg, clamped +-150deg), interpolation_duration 8, so it turns smoothly in 0.4 s. Hold while the agent is seated and needs_you; if the agent then walks to the whiteboard the chair stays turned out (looks just-left). Back to working: rotate back to the spot yaw. Desk free: chair tucked 0.18 toward the desk, yaw = spot yaw. done: 3 s swivel toward the player as a \"finished!\" glance, then back.",
  "laptop": "unchanged (art/laptop): working / idle / needs_you / closed (free desk).",
  "wall_clock": "none: the item definition is a minecraft:time (daytime) range_dispatch, so every client shows its own in-game time in 15-minute steps with zero packets.",
  "static": "everything else never changes after spawn."
 },
