{
	"schemaVersion": 1,
	"id": "t3craft",
	"version": "${version}",
	"name": "T3 Craft",
	"description": "Talk to your T3 Code threads from inside Minecraft, then keep playing while the agent works.",
	"authors": ["Maxwell Young", "Alexandros Lekkas"],
	"license": "MIT",
	"contact": {
		"homepage": "https://github.com/alexandros-lekkas/t3craft",
		"sources": "https://github.com/alexandros-lekkas/t3craft",
		"issues": "https://github.com/alexandros-lekkas/t3craft/issues"
	},
	"icon": "assets/t3craft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["dev.maxwellyoung.t3craft.T3CraftCommon"],
		"client": ["dev.maxwellyoung.t3craft.T3CraftClient"],
		"server": ["dev.maxwellyoung.t3craft.T3CraftServer"]
	},
	"mixins": ["t3craft.mixins.json", {"config": "t3craft.dev.mixins.json", "environment": "client"}],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": ">=0.161.0"
	}
}
