{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "off",
        "model": {
          "type": "minecraft:model",
          "model": "t3craft:item/desk_lamp"
        }
      },
      {
        "when": "on",
        "model": {
          "type": "minecraft:model",
          "model": "t3craft:item/desk_lamp_on"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "t3craft:item/desk_lamp"
    }
  }
}
