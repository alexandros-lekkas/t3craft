{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "white",
        "model": {
          "type": "minecraft:model",
          "model": "t3craft:item/coffee_mug"
        }
      },
      {
        "when": "sage",
        "model": {
          "type": "minecraft:model",
          "model": "t3craft:item/coffee_mug_sage"
        }
      },
      {
        "when": "charcoal",
        "model": {
          "type": "minecraft:model",
          "model": "t3craft:item/coffee_mug_charcoal"
        }
      },
      {
        "when": "white_steam",
        "model": {
          "type": "minecraft:model",
          "model": "t3craft:item/coffee_mug_steam"
        }
      },
      {
        "when": "sage_steam",
        "model": {
          "type": "minecraft:model",
          "model": "t3craft:item/coffee_mug_sage_steam"
        }
      },
      {
        "when": "charcoal_steam",
        "model": {
          "type": "minecraft:model",
          "model": "t3craft:item/coffee_mug_charcoal_steam"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "t3craft:item/coffee_mug"
    }
  }
}
