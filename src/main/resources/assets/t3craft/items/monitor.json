{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "on",
        "model": {
          "type": "minecraft:model",
          "model": "t3craft:item/monitor"
        }
      },
      {
        "when": "idle",
        "model": {
          "type": "minecraft:model",
          "model": "t3craft:item/monitor_idle"
        }
      },
      {
        "when": "off",
        "model": {
          "type": "minecraft:model",
          "model": "t3craft:item/monitor_off"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "t3craft:item/monitor_idle"
    }
  }
}
