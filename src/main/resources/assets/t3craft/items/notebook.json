{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "open",
        "model": {
          "type": "minecraft:model",
          "model": "t3craft:item/notebook"
        }
      },
      {
        "when": "closed",
        "model": {
          "type": "minecraft:model",
          "model": "t3craft:item/notebook_closed"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "t3craft:item/notebook"
    }
  }
}
